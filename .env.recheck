# Reference env for “host Nest + infra from docker compose”.
# Copy values into `.env` / `.env.dev` or merge with your local file.
#
# Compose reads `.env` in the project root for ${POSTGRES_HOST_PORT} etc. when you run
# `docker compose up`. Nest (on the host) uses DB_* and RABBITMQ_URL below — keep
# DB_PORT equal to POSTGRES_HOST_PORT and the amqp port in RABBITMQ_URL equal to
# RABBITMQ_AMQP_HOST_PORT.

POSTGRES_HOST_PORT=5432
RABBITMQ_AMQP_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres

RABBITMQ_URL=amqp://guest:guest@localhost:5673
